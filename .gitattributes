* text=auto
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.uplugin text eol=lf
*.uproject text eol=lf
# Binary Unreal assets belong in version control, through Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
